# Copy to /etc/remote-tools/env and set your auth key before running install.sh
#
# Generate a reusable, non-ephemeral key at:
# https://login.tailscale.com/admin/settings/keys
#
# Recommended key settings:
#   - Reusable: yes
#   - Ephemeral: no
#   - Pre-approved: yes (if using ACL tags)

TS_AUTHKEY=tskey-auth-REPLACE-ME

# Optional: hostname shown in the Tailscale admin console
# TS_HOSTNAME=my-remote-host

# Optional: extra tailscale up flags
# Defaults: --accept-routes --advertise-exit-node
# TS_EXTRA_ARGS=--accept-routes --advertise-exit-node --advertise-tags=tag:remote
# Note: do not use --ssh here. Tailscale SSH runs inside the container and
# cannot see host users (e.g. "failed to look up local user"). Use host sshd
# over the tailnet instead.
#
# Exit node: after first connect, approve this machine as an exit node in the
# Tailscale admin console (Machines → … → Edit route settings → Use as exit node).
# Note: remote-tools also runs `tailscale set` with these flags after start so
# already-authenticated nodes pick up --advertise-exit-node (containerboot's
# TS_AUTH_ONCE path otherwise drops TS_EXTRA_ARGS).
